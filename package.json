{
  "name": "bot-team",
  "productName": "Bot Team",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local multi-bot workspace: many bots, each with its own model backend (opencode / codex / antigravity), independent memory, and bot-to-bot handoff.",
  "author": "Bot Team contributors",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "check": "node scripts/check-syntax.mjs",
    "dist:all": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "sign:check": "bash scripts/check-signing.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.botteam.desktop",
    "productName": "Bot Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "server.mjs",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Bot Team ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterSign": "build/notarize.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Bot-Team-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Bot-Team-${version}-${arch}-portable.${ext}"
    },
    "artifactName": "Bot-Team-${version}-${arch}.${ext}"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^5.5.207",
    "pptx-preview": "^1.0.7",
    "turndown": "^7.2.5",
    "xlsx": "^0.18.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuoyulang-123456/bot-team.git"
  },
  "homepage": "https://github.com/zhuoyulang-123456/bot-team",
  "bugs": {
    "url": "https://github.com/zhuoyulang-123456/bot-team/issues"
  },
  "keywords": [
    "electron",
    "ai",
    "agents",
    "multi-agent",
    "codex",
    "claude",
    "opencode",
    "antigravity",
    "workbuddy",
    "qoder",
    "windows",
    "macos"
  ],
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "mammoth": "^1.13.0",
    "undici": "^7.30.1"
  }
}
